{
	"schemaVersion": 1,
	"id": "infusedclasses",
	"version": "${version}",
	"name": "Infused Classes",
	"description": "Character classes for Minecraft. Juggernaut: Rush engage with cleanse, Momentum armor when landing hits, Rend execute to spend it. Legionary: Rotate stances, Impetus/Testudo flip buffs, Aequilibrium oath.",
	"authors": ["hunter1712"],
	"contact": {
		"homepage": "https://github.com/Hunter1712/infusedclasses",
		"sources": "https://github.com/Hunter1712/infusedclasses",
		"issues": "https://github.com/Hunter1712/infusedclasses/issues"
	},
	"license": "ARR",
	"environment": "*",
	"mixins": [
		"infusedclasses.mixins.json"
	],
	"entrypoints": {
		"main": [
			"com.hunter1712.infusedclasses.InfusedClasses"
		],
		"client": [
			"com.hunter1712.infusedclasses.client.InfusedClassesClient"
		]
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=21",
		"fabric-api": "*"
	}
}