{
	"schemaVersion": 1,
	"id": "infusedclasses",
	"version": "${version}",
	"name": "Infused Classes",
	"description": "Character classes for Minecraft. Start as a Juggernaut: Rush engage with cleanse, Momentum armor when landing hits, Rend execute to spend it.",
	"authors": ["hunter1712"],
	"license": "MIT",
	"environment": "*",
	"mixins": [
		"infusedclasses.mixins.json"
	],
	"entrypoints": {
		"main": [
			"com.hunter1712.infusedclasses.InfusedClasses"
		],
		"client": [
			"com.hunter1712.infusedclasses.client.InfusedClassesClient"
		]
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=21",
		"fabric-api": "*"
	}
}