	"authors": [],
	"contact": {},
	"license": "MIT",
	"environment": "*",
	"mixins": [
		"infusedclasses.mixins.json"
	],
	"entrypoints": {
		"main": [
			"dev.infusedclasses.InfusedClasses"
		],
		"client": [
